{
  "version": 2,
  "outputDirectory": "serena",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/api/tts",  "destination": "/api/tts.js"  },
    { "source": "/(.*)",     "destination": "/serena/$1"   }
  ]
}
